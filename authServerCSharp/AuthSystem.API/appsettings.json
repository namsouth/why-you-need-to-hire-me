{
  "Database": {
    "SqlitePath": "Data Source=authsystem.db"
  },
  "Jwt": {
    "Issuer": "AuthSystem",
    "Audience": "AuthSystemUsers",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AuthSystem": "Information"
    }
  },
  "AllowedHosts": "*"
}